# ──────────────────────────────────────────────────────────────────────────────
# OffshoreSync contracts — ZKSync Era (Phase 0 spike)
# Copy to .env and fill in. .env is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# Deployer EOA private key (0x-prefixed). Funded with Sepolia ETH on L1,
# bridged to ZKSync Era Sepolia for L2 gas.
# Bridge: https://portal.zksync.io/bridge/?network=sepolia
DEPLOYER_PRIVATE_KEY=

# Optional RPC overrides (defaults are baked into hardhat.config.ts).
ZKSYNC_SEPOLIA_RPC_URL=
ETH_SEPOLIA_RPC_URL=
ZKSYNC_MAINNET_RPC_URL=
ETH_MAINNET_RPC_URL=
