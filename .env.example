# ──────────────────────────────────────────────────────────────────────────────
# Cofferdam contracts — ZKSync Era
# Copy to .env and fill in. .env is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# Deployer EOA private key (0x-prefixed). Funded with Sepolia ETH on L1,
# bridged to ZKSync Era Sepolia for L2 gas.
# Bridge: https://portal.zksync.io/bridge/?network=sepolia
DEPLOYER_PRIVATE_KEY=

# Optional RPC overrides (defaults are baked into hardhat.config.ts).
ZKSYNC_SEPOLIA_RPC_URL=
ETH_SEPOLIA_RPC_URL=
ZKSYNC_MAINNET_RPC_URL=
ETH_MAINNET_RPC_URL=

# ──────────────────────────────────────────────────────────────────────────────
# Phase 1 — `yarn deploy:phase1:<network>` env vars
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated 0x addresses to seed `SelfAttesterRegistry`'s allow-list.
# - Local dev: any random 0x address works (you'll be using MockSelfGroth16Verifier
#   anyway, or signing with your own key for integration tests).
# - Sepolia:  Self.xyz STAGING TEE attester ECDSA address. Source: pull from
#   `@selfxyz/mobile-sdk-alpha` SDK constants (TODO: link once we wire the
#   mobile SDK integration in Phase 2).
# - Mainnet:  Self.xyz PRODUCTION TEE attester ECDSA address. Same source.
SELF_TEE_ATTESTERS=

# Application scope for `NullifierRegistry` (uint256, decimal or 0x-hex).
# Self's circuit binds proofs to a `scope` field — different scope ⇒ proof
# is unusable on this registry. Computed off-chain as Poseidon(<app id string>).
# For local dev set to "1". For staging/production we'll publish the canonical
# value once the mobile SDK is wired up.
NULLIFIER_REGISTRY_SCOPE=
